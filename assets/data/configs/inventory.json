{
  "appTitle": "Inventory",
  "menus": [
    {
      "id": "products",
      "title": "Products",
      "icon": "inventory_2",
      "subMenus": [
        {
          "id": "product_add",
          "title": "Add",
          "icon": "add_box",
          "form": {
            "title": "Add Product",
            "fields": [
              {
                "key": "sku",
                "type": "text",
                "label": "SKU",
                "hint": "e.g. SKU-1001",
                "required": true
              },
              {
                "key": "name",
                "type": "text",
                "label": "Product Name",
                "required": true
              },
              {
                "key": "price",
                "type": "number",
                "label": "Price (₹)",
                "required": true
              },
              {
                "key": "description",
                "type": "multiline",
                "label": "Description"
              }
            ],
            "buttons": [
              {
                "label": "Reset",
                "action": "reset"
              },
              {
                "label": "Add Product",
                "action": "submit"
              }
            ]
          }
        },
        {
          "id": "product_stock",
          "title": "Stock",
          "icon": "stacked_bar_chart",
          "form": {
            "title": "Update Stock",
            "fields": [
              {
                "key": "sku",
                "type": "text",
                "label": "SKU",
                "required": true
              },
              {
                "key": "quantity",
                "type": "number",
                "label": "New Quantity",
                "required": true
              }
            ],
            "buttons": [
              {
                "label": "Update",
                "action": "submit"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "warehouses",
      "title": "Warehouses",
      "icon": "warehouse",
      "subMenus": [
        {
          "id": "warehouse_transfer",
          "title": "Stock Transfer",
          "icon": "swap_horiz",
          "form": {
            "title": "Stock Transfer",
            "fields": [
              {
                "key": "fromWarehouse",
                "type": "text",
                "label": "From Warehouse",
                "required": true
              },
              {
                "key": "toWarehouse",
                "type": "text",
                "label": "To Warehouse",
                "required": true
              },
              {
                "key": "sku",
                "type": "text",
                "label": "SKU",
                "required": true
              },
              {
                "key": "quantity",
                "type": "number",
                "label": "Quantity",
                "required": true
              }
            ],
            "buttons": [
              {
                "label": "Cancel",
                "action": "cancel"
              },
              {
                "label": "Transfer",
                "action": "submit"
              }
            ]
          }
        },
        {
          "id": "warehouse_audit",
          "title": "Stock Audit",
          "icon": "fact_check",
          "form": {
            "title": "Stock Audit",
            "fields": [
              {
                "key": "warehouse",
                "type": "text",
                "label": "Warehouse",
                "required": true
              },
              {
                "key": "remarks",
                "type": "multiline",
                "label": "Remarks"
              }
            ],
            "buttons": [
              {
                "label": "Submit Audit",
                "action": "submit"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "suppliers",
      "title": "Suppliers",
      "icon": "local_shipping",
      "subMenus": [
        {
          "id": "suppliers_vendors",
          "title": "Vendors",
          "icon": "handshake",
          "subMenus": [
            {
              "id": "supplier_add",
              "title": "Add Supplier",
              "icon": "add_business",
              "form": {
                "title": "Add Supplier",
                "fields": [
                  {
                    "key": "company",
                    "type": "text",
                    "label": "Company",
                    "required": true
                  },
                  {
                    "key": "email",
                    "type": "email",
                    "label": "Email",
                    "required": true
                  },
                  {
                    "key": "phone",
                    "type": "phone",
                    "label": "Phone"
                  }
                ],
                "buttons": [
                  {
                    "label": "Save",
                    "action": "submit"
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "suppliers_po",
          "title": "Purchase Orders",
          "icon": "request_quote",
          "subMenus": [
            {
              "id": "po_create",
              "title": "Create PO",
              "icon": "request_quote",
              "form": {
                "title": "Create Purchase Order",
                "fields": [
                  {
                    "key": "supplier",
                    "type": "text",
                    "label": "Supplier",
                    "required": true
                  },
                  {
                    "key": "sku",
                    "type": "text",
                    "label": "SKU",
                    "required": true
                  },
                  {
                    "key": "quantity",
                    "type": "number",
                    "label": "Quantity",
                    "required": true
                  }
                ],
                "buttons": [
                  {
                    "label": "Reset",
                    "action": "reset"
                  },
                  {
                    "label": "Raise PO",
                    "action": "submit"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "sync",
      "title": "ERP Sync",
      "icon": "sync",
      "form": {
        "title": "Sync with ERP",
        "fields": [
          {
            "key": "token",
            "type": "password",
            "label": "ERP Access Token",
            "required": true
          }
        ],
        "buttons": [
          {
            "label": "Sync Now",
            "action": "submit"
          }
        ]
      }
    }
  ]
}
