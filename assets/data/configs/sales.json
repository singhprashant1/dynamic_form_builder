{
  "appTitle": "Sales & CRM",
  "menus": [
    {
      "id": "customer",
      "title": "Customers",
      "icon": "people",
      "subMenus": [
        {
          "id": "customer_add",
          "title": "Add Customer",
          "icon": "person_add",
          "form": {
            "title": "New Customer",
            "fields": [
              {
                "key": "name",
                "type": "text",
                "label": "Full Name",
                "hint": "Enter full name",
                "required": true
              },
              {
                "key": "email",
                "type": "email",
                "label": "Email",
                "hint": "name@example.com",
                "required": true
              },
              {
                "key": "phone",
                "type": "phone",
                "label": "Phone",
                "hint": "10 digit number",
                "required": true
              },
              {
                "key": "address",
                "type": "multiline",
                "label": "Address",
                "hint": "Street, City, ZIP"
              }
            ],
            "buttons": [
              {
                "label": "Reset",
                "action": "reset"
              },
              {
                "label": "Save",
                "action": "submit"
              }
            ]
          }
        },
        {
          "id": "customer_search",
          "title": "Search Customer",
          "icon": "search",
          "form": {
            "title": "Search",
            "fields": [
              {
                "key": "query",
                "type": "text",
                "label": "Name or Email",
                "required": true
              }
            ],
            "buttons": [
              {
                "label": "Search",
                "action": "submit"
              }
            ]
          }
        },
        {
          "id": "customer_feedback",
          "title": "Customer Feedback",
          "icon": "feedback",
          "form": {
            "title": "Feedback",
            "fields": [
              {
                "key": "customerEmail",
                "type": "email",
                "label": "Customer Email",
                "required": true
              },
              {
                "key": "rating",
                "type": "number",
                "label": "Rating (1-5)",
                "required": true
              },
              {
                "key": "comments",
                "type": "multiline",
                "label": "Comments"
              }
            ],
            "buttons": [
              {
                "label": "Cancel",
                "action": "cancel"
              },
              {
                "label": "Submit",
                "action": "submit"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "orders",
      "title": "Orders",
      "icon": "shopping_cart",
      "subMenus": [
        {
          "id": "orders_new",
          "title": "New Order",
          "icon": "add_shopping_cart",
          "form": {
            "title": "Create Order",
            "fields": [
              {
                "key": "productCode",
                "type": "text",
                "label": "Product Code",
                "required": true
              },
              {
                "key": "quantity",
                "type": "number",
                "label": "Quantity",
                "required": true
              },
              {
                "key": "notes",
                "type": "multiline",
                "label": "Notes"
              }
            ],
            "buttons": [
              {
                "label": "Reset",
                "action": "reset"
              },
              {
                "label": "Place Order",
                "action": "submit"
              }
            ]
          }
        },
        {
          "id": "orders_track",
          "title": "Track",
          "icon": "local_shipping",
          "form": {
            "title": "Track Order",
            "fields": [
              {
                "key": "orderId",
                "type": "text",
                "label": "Order ID",
                "hint": "e.g. ORD-10293",
                "required": true
              }
            ],
            "buttons": [
              {
                "label": "Track",
                "action": "submit"
              }
            ]
          }
        },
        {
          "id": "orders_reports",
          "title": "Reports",
          "icon": "bar_chart",
          "subMenus": [
            {
              "id": "orders_reports_daily",
              "title": "Daily Report",
              "icon": "today",
              "form": {
                "title": "Daily Report",
                "fields": [
                  {
                    "key": "date",
                    "type": "text",
                    "label": "Date",
                    "hint": "YYYY-MM-DD",
                    "required": true
                  }
                ],
                "buttons": [
                  {
                    "label": "Generate",
                    "action": "submit"
                  }
                ]
              }
            },
            {
              "id": "orders_reports_monthly",
              "title": "Monthly Report",
              "icon": "calendar_month",
              "form": {
                "title": "Monthly Report",
                "fields": [
                  {
                    "key": "month",
                    "type": "text",
                    "label": "Month",
                    "hint": "YYYY-MM",
                    "required": true
                  }
                ],
                "buttons": [
                  {
                    "label": "Generate",
                    "action": "submit"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "leads",
      "title": "Leads",
      "icon": "trending_up",
      "subMenus": [
        {
          "id": "leads_prospects",
          "title": "Prospects",
          "icon": "person_search",
          "subMenus": [
            {
              "id": "leads_add",
              "title": "Add Lead",
              "icon": "person_add",
              "form": {
                "title": "Add Lead",
                "fields": [
                  {
                    "key": "company",
                    "type": "text",
                    "label": "Company",
                    "required": true
                  },
                  {
                    "key": "contact",
                    "type": "text",
                    "label": "Contact Person",
                    "required": true
                  },
                  {
                    "key": "email",
                    "type": "email",
                    "label": "Email",
                    "required": true
                  }
                ],
                "buttons": [
                  {
                    "label": "Cancel",
                    "action": "cancel"
                  },
                  {
                    "label": "Save Lead",
                    "action": "submit"
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "leads_campaigns",
          "title": "Campaigns",
          "icon": "campaign",
          "subMenus": [
            {
              "id": "campaign_new",
              "title": "New Campaign",
              "icon": "campaign",
              "form": {
                "title": "New Campaign",
                "fields": [
                  {
                    "key": "name",
                    "type": "text",
                    "label": "Campaign Name",
                    "required": true
                  },
                  {
                    "key": "message",
                    "type": "multiline",
                    "label": "Message",
                    "required": true
                  }
                ],
                "buttons": [
                  {
                    "label": "Launch",
                    "action": "submit"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "settings",
      "title": "Settings",
      "icon": "settings",
      "form": {
        "title": "Change Password",
        "fields": [
          {
            "key": "currentPassword",
            "type": "password",
            "label": "Current Password",
            "required": true
          },
          {
            "key": "newPassword",
            "type": "password",
            "label": "New Password",
            "required": true
          }
        ],
        "buttons": [
          {
            "label": "Update",
            "action": "submit"
          }
        ]
      }
    }
  ]
}
