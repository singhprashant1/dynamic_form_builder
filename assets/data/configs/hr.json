{
  "appTitle": "HR Portal",
  "menus": [
    {
      "id": "employees",
      "title": "Employees",
      "icon": "badge",
      "subMenus": [
        {
          "id": "employee_onboard",
          "title": "Onboard",
          "icon": "person_add",
          "form": {
            "title": "Onboard Employee",
            "fields": [
              {
                "key": "fullName",
                "type": "text",
                "label": "Full Name",
                "required": true
              },
              {
                "key": "workEmail",
                "type": "email",
                "label": "Work Email",
                "required": true
              },
              {
                "key": "department",
                "type": "text",
                "label": "Department",
                "required": true
              },
              {
                "key": "joiningDate",
                "type": "text",
                "label": "Joining Date",
                "hint": "YYYY-MM-DD",
                "required": true
              }
            ],
            "buttons": [
              {
                "label": "Reset",
                "action": "reset"
              },
              {
                "label": "Onboard",
                "action": "submit"
              }
            ]
          }
        },
        {
          "id": "employee_directory",
          "title": "Directory",
          "icon": "contacts",
          "form": {
            "title": "Employee Directory",
            "fields": [
              {
                "key": "query",
                "type": "text",
                "label": "Name or Employee ID",
                "required": true
              }
            ],
            "buttons": [
              {
                "label": "Search",
                "action": "submit"
              }
            ]
          }
        },
        {
          "id": "employee_profile",
          "title": "Update Profile",
          "icon": "edit",
          "form": {
            "title": "Update Profile",
            "fields": [
              {
                "key": "employeeId",
                "type": "text",
                "label": "Employee ID",
                "required": true
              },
              {
                "key": "phone",
                "type": "phone",
                "label": "Phone"
              },
              {
                "key": "address",
                "type": "multiline",
                "label": "Address"
              }
            ],
            "buttons": [
              {
                "label": "Cancel",
                "action": "cancel"
              },
              {
                "label": "Save",
                "action": "submit"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "leave",
      "title": "Leave",
      "icon": "beach_access",
      "subMenus": [
        {
          "id": "leave_apply",
          "title": "Apply",
          "icon": "event",
          "form": {
            "title": "Apply Leave",
            "fields": [
              {
                "key": "from",
                "type": "text",
                "label": "From",
                "hint": "YYYY-MM-DD",
                "required": true
              },
              {
                "key": "to",
                "type": "text",
                "label": "To",
                "hint": "YYYY-MM-DD",
                "required": true
              },
              {
                "key": "reason",
                "type": "multiline",
                "label": "Reason",
                "required": true
              }
            ],
            "buttons": [
              {
                "label": "Reset",
                "action": "reset"
              },
              {
                "label": "Apply",
                "action": "submit"
              }
            ]
          }
        },
        {
          "id": "leave_balance",
          "title": "Balance",
          "icon": "pie_chart",
          "form": {
            "title": "Leave Balance",
            "fields": [
              {
                "key": "employeeId",
                "type": "text",
                "label": "Employee ID",
                "required": true
              }
            ],
            "buttons": [
              {
                "label": "Check",
                "action": "submit"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "payroll",
      "title": "Payroll",
      "icon": "payments",
      "subMenus": [
        {
          "id": "payroll_salary",
          "title": "Salary",
          "icon": "account_balance",
          "subMenus": [
            {
              "id": "payroll_payslip",
              "title": "Request Payslip",
              "icon": "receipt_long",
              "form": {
                "title": "Request Payslip",
                "fields": [
                  {
                    "key": "month",
                    "type": "text",
                    "label": "Month",
                    "hint": "YYYY-MM",
                    "required": true
                  },
                  {
                    "key": "email",
                    "type": "email",
                    "label": "Send to",
                    "required": true
                  }
                ],
                "buttons": [
                  {
                    "label": "Request",
                    "action": "submit"
                  }
                ]
              }
            },
            {
              "id": "payroll_tax",
              "title": "Tax Declaration",
              "icon": "description",
              "form": {
                "title": "Tax Declaration",
                "fields": [
                  {
                    "key": "pan",
                    "type": "text",
                    "label": "PAN",
                    "hint": "ABCDE1234F",
                    "required": true
                  },
                  {
                    "key": "investments",
                    "type": "number",
                    "label": "Investments (₹)"
                  }
                ],
                "buttons": [
                  {
                    "label": "Submit",
                    "action": "submit"
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "payroll_claims",
          "title": "Reimbursement",
          "icon": "receipt",
          "subMenus": [
            {
              "id": "payroll_claim",
              "title": "Submit Claim",
              "icon": "receipt",
              "form": {
                "title": "Submit Claim",
                "fields": [
                  {
                    "key": "amount",
                    "type": "number",
                    "label": "Amount (₹)",
                    "required": true
                  },
                  {
                    "key": "details",
                    "type": "multiline",
                    "label": "Details",
                    "required": true
                  }
                ],
                "buttons": [
                  {
                    "label": "Cancel",
                    "action": "cancel"
                  },
                  {
                    "label": "Submit",
                    "action": "submit"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "helpdesk",
      "title": "Help Desk",
      "icon": "support_agent",
      "form": {
        "title": "Raise Ticket",
        "fields": [
          {
            "key": "subject",
            "type": "text",
            "label": "Subject",
            "required": true
          },
          {
            "key": "description",
            "type": "multiline",
            "label": "Description",
            "required": true
          }
        ],
        "buttons": [
          {
            "label": "Raise Ticket",
            "action": "submit"
          }
        ]
      }
    }
  ]
}
