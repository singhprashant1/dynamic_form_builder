{
  "appTitle": "School Admin",
  "menus": [
    {
      "id": "students",
      "title": "Students",
      "icon": "school",
      "subMenus": [
        {
          "id": "student_admission",
          "title": "Admission",
          "icon": "how_to_reg",
          "form": {
            "title": "New Admission",
            "fields": [
              {
                "key": "studentName",
                "type": "text",
                "label": "Student Name",
                "required": true
              },
              {
                "key": "grade",
                "type": "number",
                "label": "Grade",
                "required": true
              },
              {
                "key": "parentEmail",
                "type": "email",
                "label": "Parent Email",
                "required": true
              },
              {
                "key": "parentPhone",
                "type": "phone",
                "label": "Parent Phone",
                "required": true
              }
            ],
            "buttons": [
              {
                "label": "Reset",
                "action": "reset"
              },
              {
                "label": "Admit",
                "action": "submit"
              }
            ]
          }
        },
        {
          "id": "student_attendance",
          "title": "Attendance",
          "icon": "event_available",
          "form": {
            "title": "Mark Absence",
            "fields": [
              {
                "key": "rollNo",
                "type": "text",
                "label": "Roll No.",
                "required": true
              },
              {
                "key": "date",
                "type": "text",
                "label": "Date",
                "hint": "YYYY-MM-DD",
                "required": true
              }
            ],
            "buttons": [
              {
                "label": "Save",
                "action": "submit"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "teachers",
      "title": "Teachers",
      "icon": "person",
      "subMenus": [
        {
          "id": "teacher_add",
          "title": "Add Teacher",
          "icon": "person_add",
          "form": {
            "title": "Add Teacher",
            "fields": [
              {
                "key": "name",
                "type": "text",
                "label": "Name",
                "required": true
              },
              {
                "key": "subject",
                "type": "text",
                "label": "Subject",
                "required": true
              },
              {
                "key": "email",
                "type": "email",
                "label": "Email",
                "required": true
              }
            ],
            "buttons": [
              {
                "label": "Cancel",
                "action": "cancel"
              },
              {
                "label": "Save",
                "action": "submit"
              }
            ]
          }
        },
        {
          "id": "teacher_assign",
          "title": "Assign Class",
          "icon": "class",
          "form": {
            "title": "Assign Class",
            "fields": [
              {
                "key": "teacherId",
                "type": "text",
                "label": "Teacher ID",
                "required": true
              },
              {
                "key": "classSection",
                "type": "text",
                "label": "Class & Section",
                "hint": "e.g. 8-B",
                "required": true
              }
            ],
            "buttons": [
              {
                "label": "Assign",
                "action": "submit"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "exams",
      "title": "Exams",
      "icon": "assignment",
      "subMenus": [
        {
          "id": "exams_schedule",
          "title": "Schedule",
          "icon": "event",
          "subMenus": [
            {
              "id": "exam_create",
              "title": "Create Exam",
              "icon": "add_task",
              "form": {
                "title": "Create Exam",
                "fields": [
                  {
                    "key": "subject",
                    "type": "text",
                    "label": "Subject",
                    "required": true
                  },
                  {
                    "key": "date",
                    "type": "text",
                    "label": "Date",
                    "hint": "YYYY-MM-DD",
                    "required": true
                  },
                  {
                    "key": "maxMarks",
                    "type": "number",
                    "label": "Max Marks",
                    "required": true
                  }
                ],
                "buttons": [
                  {
                    "label": "Schedule",
                    "action": "submit"
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "exams_results",
          "title": "Results",
          "icon": "emoji_events",
          "subMenus": [
            {
              "id": "result_publish",
              "title": "Publish Result",
              "icon": "publish",
              "form": {
                "title": "Publish Result",
                "fields": [
                  {
                    "key": "examId",
                    "type": "text",
                    "label": "Exam ID",
                    "required": true
                  },
                  {
                    "key": "notes",
                    "type": "multiline",
                    "label": "Notes for parents"
                  }
                ],
                "buttons": [
                  {
                    "label": "Publish",
                    "action": "submit"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "fees",
      "title": "Fees",
      "icon": "account_balance_wallet",
      "form": {
        "title": "Record Fee Payment",
        "fields": [
          {
            "key": "rollNo",
            "type": "text",
            "label": "Roll No.",
            "required": true
          },
          {
            "key": "amount",
            "type": "number",
            "label": "Amount (₹)",
            "required": true
          }
        ],
        "buttons": [
          {
            "label": "Reset",
            "action": "reset"
          },
          {
            "label": "Record",
            "action": "submit"
          }
        ]
      }
    }
  ]
}
