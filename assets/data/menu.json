{
  "appTitle": "Dynamic Form Builder",
  "menus": [
    {
      "id": "customer",
      "title": "Customer",
      "icon": "person",
      "subMenus": [
        {
          "id": "customer_add",
          "title": "Add Customer",
          "icon": "person_add",
          "form": {
            "title": "New Customer",
            "fields": [
              { "key": "name", "type": "text", "label": "Full Name", "hint": "Enter full name", "required": true, "minLength": 3 },
              { "key": "email", "type": "email", "label": "Email", "hint": "name@example.com", "required": true },
              { "key": "phone", "type": "phone", "label": "Phone", "hint": "10 digit number", "required": true, "pattern": "^[0-9]{10}$", "patternMessage": "Enter a valid 10 digit number" },
              { "key": "address", "type": "multiline", "label": "Address", "hint": "Street, City, ZIP", "maxLines": 3 }
            ],
            "buttons": [
              { "label": "Reset", "action": "reset", "style": "outlined" },
              { "label": "Save", "action": "submit", "style": "elevated" }
            ]
          }
        },
        {
          "id": "customer_search",
          "title": "Search Customer",
          "icon": "search",
          "form": {
            "title": "Search",
            "fields": [
              { "key": "query", "type": "text", "label": "Name or Email", "required": true }
            ],
            "buttons": [
              { "label": "Search", "action": "submit", "style": "elevated" }
            ]
          }
        }
      ]
    },
    {
      "id": "orders",
      "title": "Orders",
      "icon": "shopping_cart",
      "subMenus": [
        {
          "id": "orders_new",
          "title": "New Order",
          "icon": "add_shopping_cart",
          "form": {
            "title": "Create Order",
            "fields": [
              { "key": "productCode", "type": "text", "label": "Product Code", "required": true },
              { "key": "quantity", "type": "number", "label": "Quantity", "required": true, "initialValue": "1" },
              { "key": "notes", "type": "multiline", "label": "Notes", "maxLines": 4 }
            ],
            "buttons": [
              { "label": "Cancel", "action": "cancel", "style": "text" },
              { "label": "Reset", "action": "reset", "style": "outlined" },
              { "label": "Place Order", "action": "submit", "style": "elevated" }
            ]
          }
        },
        {
          "id": "orders_reports",
          "title": "Reports",
          "icon": "bar_chart",
          "subMenus": [
            {
              "id": "orders_reports_daily",
              "title": "Daily Report",
              "icon": "today",
              "form": {
                "title": "Daily Report",
                "fields": [
                  { "key": "date", "type": "text", "label": "Date", "hint": "YYYY-MM-DD", "required": true, "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "patternMessage": "Use format YYYY-MM-DD" }
                ],
                "buttons": [
                  { "label": "Generate", "action": "submit", "style": "elevated" }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "settings",
      "title": "Settings",
      "icon": "settings",
      "form": {
        "title": "Change Password",
        "fields": [
          { "key": "currentPassword", "type": "password", "label": "Current Password", "required": true },
          { "key": "newPassword", "type": "password", "label": "New Password", "required": true, "minLength": 8 }
        ],
        "buttons": [
          { "label": "Update", "action": "submit", "style": "elevated" }
        ]
      }
    }
  ]
}
